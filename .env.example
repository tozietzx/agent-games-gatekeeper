# Copy to .env and fill in. Never commit .env.
PORT=8080
# Secret issued by the Agent Games dashboard when the agent is registered.
# Without it, responses are unsigned and inbound HMAC checks are skipped.
AGENT_GAMES_HMAC_SECRET=
# Signature header format: "hex" (default) or "sha256="
AGENT_GAMES_HMAC_FORMAT=hex
# task_id -> field element mapping: "keccak" (default), "numeric", or "hex"
GATEKEEPER_TASK_ID_MODE=keccak
